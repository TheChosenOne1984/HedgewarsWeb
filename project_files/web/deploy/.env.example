# Copy to .env and adjust; docker compose reads it from this directory.

# Host name of the site; Caddy gets a TLS certificate for it.
DOMAIN=hw.example.org

# The web client's "Source code" link (GPL: the code you serve). Point it at
# the exact revision you deploy, e.g. https://github.com/TheChosenOne1984/HedgewarsWeb/tree/<commit>
SOURCE_URL=https://github.com/TheChosenOne1984/HedgewarsWeb

# Optional basic auth for the whole site, the game connection included.
# Leave the password empty for an open site. Single quotes keep special
# characters literal.
BASIC_AUTH_USER=hedgewars
BASIC_AUTH_PASSWORD=''

# Desktop (Qt) clients connect to port 46631, which basic auth does not
# protect. Off by default; to allow them, uncomment:
#COMPOSE_FILE=docker-compose.yml:desktop-clients.yml
