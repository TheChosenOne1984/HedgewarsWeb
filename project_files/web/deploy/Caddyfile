# Hedgewars web client: static site + WebSocket proxy to the game server.
# DOMAIN: the site's host name (Caddy gets a TLS certificate for it);
# use "localhost" or ":80" for local tests.
{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' wss: ws:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# WebSocket connections of the web client; the game server trusts
	# X-Forwarded-For from this proxy only (--trusted-proxy)
	reverse_proxy /ws server:46632

	# content-addressed files never change
	@immutable path /assets/* /packs/*.hwpack
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@revalidate path / /index.html /engine/* /packs/manifest.json /packs/catalog.json
	header @revalidate Cache-Control "no-cache"

	root * /srv
	file_server
}
